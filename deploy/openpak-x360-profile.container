# PRIMARY host. OpenPak Xbox 360 profile REST service (x360-profile), hive root LiveServiceUrl.profile = http://profile.xboxlive.com.
# The console resolves profile.xboxlive.com through OpenPak's DNS to this host; Traefik routes Host(profile.xboxlive.com) on the
# plain-HTTP entrypoint to :10042. Verifies the tokens x360-xsts issues (its signing key, read-only).
[Unit]
Description=OpenPak Xbox 360 profile REST service (x360-profile)

[Container]
ContainerName=openpak-x360-profile
Image=ghcr.io/openpak/x360-profile:latest
AutoUpdate=registry
Network=openpak.network
# Pin an unused address (run pin-ips.sh --apply for new quadlets).
IP=10.89.2.237
Environment=X360_PROFILE_ADDR=:10042
Environment=X360_PROFILE_XSTS_KEY=/run/xsts/signing.key
Volume=%h/openpak/deploy/x360-xsts/state/signing.key:/run/xsts/signing.key:ro,Z
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
